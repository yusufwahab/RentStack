# ─────────────────────────────────────────────────────────────
# RentStack backend — environment variables
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# --- Supabase ---
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The "anon" public key (safe to expose to a browser, used here only for JWT verification config)
SUPABASE_ANON_KEY=
# The "service_role" secret key — full DB access, bypasses Row Level Security.
# NEVER expose this to the frontend. Backend-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Nomba ---
# From the credentials email Nomba sends you. Confirmed against
# https://developer.nomba.com as of this build:
#   Auth:            POST {NOMBA_BASE_URL}/v1/auth/token/issue                (accountId header = PARENT id)
#   Virtual account: POST {NOMBA_BASE_URL}/v1/accounts/virtual/{subAccountId} (accountId header = PARENT id)
#   Bank transfer:   POST {NOMBA_BASE_URL}/v2/transfers/bank/{subAccountId}   (accountId header = PARENT id)
#   Bank lookup:     POST {NOMBA_BASE_URL}/v1/transfers/bank/lookup
#   Bank codes:      GET  {NOMBA_BASE_URL}/v1/transfers/banks
# Use the sandbox host + TEST credentials until you're ready to go live,
# then switch the base URL and swap in the LIVE client id/private key.
NOMBA_BASE_URL=https://sandbox.nomba.com
# "Main (parent) Account ID" in the credentials email — always goes in the
# accountId header, for every call, even sub-account-scoped ones.
NOMBA_PARENT_ACCOUNT_ID=
# "Your sub-account ID" in the credentials email — used in the URL path
# for virtual account creation and transfers only.
NOMBA_SUB_ACCOUNT_ID=
# TEST or LIVE "Client ID" depending on NOMBA_BASE_URL above.
NOMBA_CLIENT_ID=
# TEST or LIVE "Private key" in Nomba's dashboard — this is the same value
# the API calls `client_secret`.
NOMBA_CLIENT_SECRET=
# Set in Nomba dashboard → Webhook Setup. Used to verify the `nomba-signature` header.
NOMBA_WEBHOOK_SECRET=

# --- SMS (Termii) ---
# https://developer.termii.com — used for payment-receipt notifications to tenants.
TERMII_API_KEY=
TERMII_SENDER_ID=RentStack

# --- Auth ---
# Only needed if you decide to sign your own short-lived service tokens
# in addition to Supabase Auth (e.g. for the Nomba webhook route, which
# Nomba itself calls and cannot carry a Supabase user session).
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_ALLOW_UNSIGNED=false
