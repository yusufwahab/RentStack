# ─────────────────────────────────────────────────────────────
# RentStack backend — environment variables
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# --- Supabase ---
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The "anon" public key (safe to expose to a browser, used here only for JWT verification config)
SUPABASE_ANON_KEY=
# The "service_role" secret key — full DB access, bypasses Row Level Security.
# NEVER expose this to the frontend. Backend-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Nomba ---
# From your Nomba dashboard → API/Developer settings.
# Confirmed against https://developer.nomba.com as of this build:
#   Auth:            POST {NOMBA_BASE_URL}/v1/auth/token/issue
#   Virtual account: POST {NOMBA_BASE_URL}/v1/accounts/virtual
#   Bank transfer:   POST {NOMBA_BASE_URL}/v2/transfers/bank
#   Bank lookup:     POST {NOMBA_BASE_URL}/v1/transfers/bank/lookup
#   Bank codes:      GET  {NOMBA_BASE_URL}/v1/transfers/banks
# Use the sandbox host until you're ready to go live.
NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_ACCOUNT_ID=
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
# Set in Nomba dashboard → Webhook Setup. Used to verify the `nomba-signature` header.
NOMBA_WEBHOOK_SECRET=

# --- SMS (Termii) ---
# https://developer.termii.com — used for payment-receipt notifications to tenants.
TERMII_API_KEY=
TERMII_SENDER_ID=RentStack

# --- Auth ---
# Only needed if you decide to sign your own short-lived service tokens
# in addition to Supabase Auth (e.g. for the Nomba webhook route, which
# Nomba itself calls and cannot carry a Supabase user session).
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_ALLOW_UNSIGNED=false
